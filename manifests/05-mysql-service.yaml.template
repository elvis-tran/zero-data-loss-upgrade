apiVersion: v1
kind: Service
metadata:
  name: mysql
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: mysql
    app.kubernetes.io/part-of: zero-data-loss-upgrade
spec:
  type: ClusterIP

  selector:
    app: mysql

  ports:
    - name: mysql
      port: 3306
      targetPort: mysql
      protocol: TCP
