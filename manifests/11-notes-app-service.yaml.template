apiVersion: v1
kind: Service
metadata:
  name: notes-app-svc
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: notes-app
    app.kubernetes.io/part-of: zero-data-loss-upgrade

spec:
  type: NodePort

  selector:
    app: notes-app

  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: http
      nodePort: ${NODE_PORT}
